# agent-bot init fills these through Feishu one-click registration.
# Leave both blank for console-only mode, or set both to bind an existing app.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional user-data root. Defaults to ~/.agent-bot.
# AGENT_BOT_HOME=~/.agent-bot
# Optional config path. Defaults to ~/.agent-bot/config.yaml.
# AGENT_BOT_CONFIG=~/.agent-bot/config.yaml

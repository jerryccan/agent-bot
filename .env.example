# agentbot init fills these through Feishu one-click registration.
# Leave them blank for console-only mode. For an existing app, the first direct
# message fills FEISHU_USER_OPEN_ID for startup notifications and CLI group invites.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_OPEN_ID=
# Optional user-data root. Defaults to ~/.agent-bot.
# AGENT_BOT_HOME=~/.agent-bot
# Optional config path. Defaults to ~/.agent-bot/config.yaml.
# AGENT_BOT_CONFIG=~/.agent-bot/config.yaml

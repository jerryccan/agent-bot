{
  "name": "agent-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Feishu-first Agent Bot for local Codex App Server and ACP agents.",
  "bin": {
    "agent-bot": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/supervisor.js",
    "start:once": "node dist/index.js",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "latest",
    "@larksuiteoapi/node-sdk": "1.56.1",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "pino": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "axios": "1.18.1"
  },
  "engines": {
    "node": ">=20"
  }
}
